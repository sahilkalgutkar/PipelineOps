# Copy to .env to override docker-compose defaults for local development.
# None of these are required — sane dev defaults are baked into docker-compose.yml.

POSTGRES_USER=pipelineops
POSTGRES_PASSWORD=pipelineops
POSTGRES_DB=pipelineops

DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true

# Seeds an admin/admin superuser on first boot so you can log into the
# dashboard and Django admin immediately. Set to false for anything shared.
DJANGO_CREATE_SUPERUSER=true
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@pipelineops.local

HEARTBEAT_CHECK_INTERVAL_SECONDS=30

# Leave blank to no-op (alerts are logged instead of sent)
SLACK_WEBHOOK_URL=
