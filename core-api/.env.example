DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

DATABASE_URL=postgres://pipelineops:pipelineops@postgres:5432/pipelineops
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
HEARTBEAT_CHECK_INTERVAL_SECONDS=30

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Alerting channels — leave blank to no-op (falls back to logging)
SLACK_WEBHOOK_URL=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=alerts@pipelineops.local
ALERT_EMAIL_RECIPIENTS=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_RECIPIENTS=
